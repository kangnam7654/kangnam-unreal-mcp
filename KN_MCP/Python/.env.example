# Unreal MCP Server – copy to .env and adjust as needed.
# All keys are optional; defaults are used when omitted.

# Unreal Engine plugin host/port (TCP)
UNREAL_HOST=127.0.0.1
UNREAL_PORT=27777

# Timeouts (seconds)
UNREAL_CONNECT_TIMEOUT=10
UNREAL_RECV_TIMEOUT=30
UNREAL_LARGE_OP_TIMEOUT=300

# Comma-separated tool names to enable; empty = all enabled
# e.g. actors,blueprints,building,castle,infrastructure,materials,physics,town
# UNREAL_ENABLED_TOOLS=
